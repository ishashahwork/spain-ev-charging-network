# ─── Raw data (too large for git, must be downloaded) ───
data/raw/

# ─── Processed geospatial (large, can be regenerated) ───
data/processed/*.gpkg
data/processed/*.geojson
data/processed/interurban_roads.csv
data/processed/interurban_roads_mitma.csv
data/processed/ev_charging_baseline_enriched.csv

# ─── v2 pipeline intermediate geospatial (large, regenerated by sNN_*.py) ───
v2/intermediate/*.gpkg
v2/intermediate/*.geojson

# ─── Competition briefing PDF and its text extraction (IE/Iberdrola IP) ───
Sources/*.pdf
Sources/pdf_content.txt

# ─── Cache files ───
cache/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ─── OS files ───
desktop.ini
Thumbs.db
.DS_Store

# ─── Environment ───
.env
*.egg-info/

# ─── IDE ───
.vscode/
.idea/

# ─── Large visualization (can be regenerated) ───
visualizations/*.html
visualizations/archive/
visualizations/v1/

# ─── Old versions / archives ───
notebooks/v1/
outputs/v1/
outputs/v1_no_province_weighting/
outputs/archive/
report/v1/

# ─── Claude Code internal ───
.claude/
